{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "rootDir": "../../",
    "outDir": "./dist",
    "lib": ["ES2020"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "../core/src/**/*"],
  "exclude": ["node_modules", ".vscode-test", "**/*.test.ts"]
}
