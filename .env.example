# Cấu hình API Keys cho Thực Nghiệm LLM (Thành viên A)
# Copy file này thành `.env` và điền key thật để chạy thực nghiệm

# 1. Google Gemini (Khuyên dùng: Miễn phí 100% tại Google AI Studio)
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. DeepSeek API (Siêu tiết kiệm, hoặc dùng Ollama Local)
# Lấy key tại: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-coder

# 3. Ollama (Chạy Local hoàn toàn miễn phí không cần API Key)
# Tải Ollama tại: https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=deepseek-coder:6.7b

# 4. OpenAI (Nếu có kinh phí nghiên cứu hoặc credit)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 5. Anthropic Claude (Tùy chọn)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Cấu hình tham số sinh code
TEMPERATURE=0.2
TOP_P=0.95
MAX_TOKENS=4096

# Cấu hình điều phối Thực nghiệm (Batch Runner)
THROTTLING_DELAY_MS=15000     # Giãn cách 15s giữa các request tránh lỗi 429 Quota Exceeded
SKIP_EXISTING_RUNS=true       # Tự động tiếp tục từ checkpoint nếu đã sinh thành công
USE_MOCK_LLM=false            # Đặt true nếu muốn chạy thử pipeline offline không tốn token

